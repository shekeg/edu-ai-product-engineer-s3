# Anthropic Claude API Key (REQUIRED)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# GitHub Personal Access Token (OPTIONAL, for higher API rate limits)
# Create at: https://github.com/settings/tokens
# Permissions needed: public_repo (for public repos) or repo (for private repos)
GITHUB_TOKEN=your_github_token_here

# Log file path (OPTIONAL, defaults to ./logs.json)
LOGS_PATH=./logs-example.json

# GitHub repository to analyze (OPTIONAL, defaults to shekeg/ai-feature-flags)
# Format: owner/repo
GITHUB_REPO=shekeg/ai-feature-flags
